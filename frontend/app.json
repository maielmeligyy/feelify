{
  "expo": {
    "name": "Feelify",
    "slug": "feelify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/feelify-logo.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B103E"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maielmeligy.feelify"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/feelify-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/spotify.png"
    },
    "experiments": {
      "newArchEnabled": true
    }
  }
}
